# ============================================================
# .env.example — copy to .env and fill in machine-specific values
# ============================================================
# NEVER commit the real .env to version control.
# The .gitignore already excludes it.
# ============================================================

# ------------------------------------------------------------------
# Dataset
# ------------------------------------------------------------------
# Absolute path to the directory that contains:
#   allclear_test_metadata.json
#   allclear_dataset/roi*/...
DATASET_ROOT=D:\allclear_test_proi1_v1

# Filename of the ALLClear metadata JSON (relative to DATASET_ROOT)
METADATA_FILE=allclear_test_metadata.json

# Sub-directory inside DATASET_ROOT holding the roi* folders
ALLCLEAR_SUBDIR=allclear_dataset

# ------------------------------------------------------------------
# Device
# ------------------------------------------------------------------
# "cuda" requires a working NVIDIA GPU + PyTorch CUDA build
DEVICE=cuda

# ------------------------------------------------------------------
# Project directories (relative to project root)
# ------------------------------------------------------------------
CHECKPOINT_DIR=checkpoints
OUTPUT_DIR=outputs
LOG_DIR=logs
DB_PATH=data/cloudremoval.db

# ------------------------------------------------------------------
# Training (MAX_EPOCHS is locked at 30 — do not exceed)
# ------------------------------------------------------------------
MAX_EPOCHS=30
BATCH_SIZE=4
LEARNING_RATE=1e-4
WEIGHT_DECAY=1e-5
VAL_FREQ=1
AMP=true
NUM_WORKERS=4
MISSING_S1_STRATEGY=skip

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=cloudremoval.log

# ------------------------------------------------------------------
# API (Phase 3+)
# ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ------------------------------------------------------------------
# Best checkpoint filename (used by inference and frontend)
# ------------------------------------------------------------------
BEST_CHECKPOINT_NAME=best_model.pth
